# Fichiers envoyés depuis l'admin (médiathèque, logo) : servis uniquement comme fichiers statiques.
# Aucun script ne doit s'y exécuter, ni aucun fichier y être interprété comme une page web.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh|asp|aspx|jsp|html?|xhtml|svgz?|js)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
