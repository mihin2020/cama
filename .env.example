APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Proxys de confiance : none sans reverse proxy ; sinon l'adresse du proxy (ou *).
TRUSTED_PROXIES=none

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données : sqlite (développement rapide), mysql ou pgsql (PostgreSQL, recommandé en production).
DB_CONNECTION=sqlite
# MySQL :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cama
# DB_USERNAME=root
# DB_PASSWORD=
# PostgreSQL :
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=cama
# DB_USERNAME=cama
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# En production : SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true (site servi en HTTPS), APP_DEBUG=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fichiers du site public envoyés depuis le studio de contenu (images, documents, logo) :
# « public » = storage/app/public (conservé entre deux déploiements) ; « s3 » = stockage distant.
SITE_UPLOADS_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_TIMEOUT=30
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=CAMA

# Adresse email recevant les messages du formulaire public
CONTACT_RECIPIENT_EMAIL=
